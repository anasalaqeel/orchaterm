{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "com.orchaterm.app.e2e",
  "mainBinaryName": "orchaterm-e2e",
  "build": {
    "beforeBuildCommand": "bun run build:e2e"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null,
      "capabilities": [
        "default",
        {
          "identifier": "e2e-wdio",
          "windows": ["main"],
          "permissions": ["wdio:default", "wdio-webdriver:default"]
        }
      ]
    }
  }
}

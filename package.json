{
  "name": "orchaterm",
  "version": "0.3.0",
  "description": "Next-generation developer terminal built for the AI era of software engineering",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/anasalaqeel/orchaterm.git"
  },
  "homepage": "https://github.com/anasalaqeel/orchaterm#readme",
  "bugs": {
    "url": "https://github.com/anasalaqeel/orchaterm/issues"
  },
  "keywords": [
    "terminal",
    "tauri",
    "ai-agents",
    "orchestration",
    "ollama",
    "xterm",
    "pty",
    "developer-tools"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\"",
    "prepare": "husky",
    "version": "node scripts/sync-version.js && cd src-tauri && cargo check && git add ../src-tauri/tauri.conf.json ../src-tauri/Cargo.toml ../src-tauri/Cargo.lock"
  },
  "dependencies": {
    "@emotion/css": "^11.13.5",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-clipboard-manager": "~2.0.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-http": "~2.5.9",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@types/uuid": "^11.0.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "lucide-react": "^1.24.0",
    "motion": "^12.42.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8.2.0",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/ui": "^4.1.10",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx,css,json}": "prettier --write"
  }
}
